{
  "externalToolsRegex": "^(search_web|fetch_webpage|web_fetch|mcp_.*|github_repo|external_api_call)$",
  "sensitiveFilenameRegex": "(^|[\\/])\\d{9,16}(\\.[^\\/]+)?$",
  "patterns": [
    {
      "name": "Credit Card",
      "enabled": true,
      "regex": "\\b(?:\\d{4}[- ]?){3}\\d{4}\\b",
      "replacement": "[MASKED-CC]"
    },
    {
      "name": "API Key",
      "enabled": true,
      "regex": "(?i)\\b(?:sk|pk|rk|token|api[_-]?key)[-_=: ]*[A-Za-z0-9._\\-]{12,}\\b",
      "replacement": "[MASKED-KEY]"
    },
    {
      "name": "Bearer Token",
      "enabled": true,
      "regex": "(?i)Bearer\\s+[A-Za-z0-9._\\-]{10,}",
      "replacement": "Bearer [MASKED-TOKEN]"
    },
    {
      "name": "Password Assignment",
      "enabled": true,
      "regex": "(?i)\\b(password|passwd|secret|pwd)\\b\\s*[:=]\\s*[^,\\s\"'}]{4,}",
      "replacement": "$1=[MASKED-PASS]"
    }
  ],
  "customPatterns": [
    {
      "name": "Demo Customer ID",
      "enabled": true,
      "regex": "(?i)(\"?customer_id\"?\\s*[:=]\\s*\"?)CUST-\\d{6}",
      "replacement": "$1[MASKED-CUSTOMER-ID]"
    }
  ]
}
